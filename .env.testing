# Entorno de TESTS. Aisla la suite del contenedor: base sqlite en memoria,
# cache/colas/mail en drivers locales sin dependencias externas (db, redis,
# mailpit, whatsapp). Mantiene los mismos valores que phpunit.xml, explicitos
# aca para quien corra los tests sin pasar por phpunit (tinker, artisan test).

APP_NAME="Clinica Dental API"
APP_ENV=testing
APP_KEY=base64:7Mn6j1P8gn0tBfU74tLbF8nXS4q2xtHklhdbQxP5kgQ=
APP_DEBUG=true
APP_URL=http://localhost

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Base en memoria: sin PostgreSQL del contenedor.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# Drivers locales, sin Redis ni servicios externos.
CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

# Correo y WhatsApp inertes en tests.
MAIL_MAILER=array
WHATSAPP_MOCK=true

# Seguridad: mismos defaults que produccion para poder testear los limites.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
TENANT_PUBLIC_HEADER=X-Clinica
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=10
RATE_LIMIT_AVAILABILITY=60
RATE_LIMIT_PUBLICO=30

BROADCAST_CONNECTION=null
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
