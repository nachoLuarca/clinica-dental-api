APP_NAME="Clinica Dental API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=8

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (servicio "db" del docker compose)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=clinica_dental
DB_USERNAME=clinica
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Colas en Redis (servicio "redis")
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis (servicio "redis" del docker compose)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit captura los correos en desarrollo (UI en http://localhost:8025), sin auth.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@clinica-dental.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Notificaciones (paso 6) ---
# Canales activos (best-effort e independientes por canal).
NOTIFICACIONES_CANALES=correo,whatsapp
# Colas separadas por tipo de trabajo.
COLA_NOTIFICACIONES=notificaciones
COLA_RECORDATORIOS=recordatorios
# Reintentos best-effort por canal antes de descartar el envio.
NOTIFICACIONES_REINTENTOS=3
NOTIFICACIONES_REINTENTOS_BACKOFF_MS=300
# Recordatorio: horas antes de la cita y ancho de la ventana de barrido (min).
RECORDATORIO_HORAS_ANTES=24
RECORDATORIO_VENTANA_MINUTOS=60
# Opcional: URL del sitio publico de pacientes (clinica-dental-paciente), para
# linkear "Mis horas" en el correo/WhatsApp de confirmacion. Sin esto, el
# mensaje igual explica el flujo (RUT + fecha de nacimiento) pero sin link.
PACIENTE_FRONTEND_URL=

# Correo. En dev el mailer por defecto (smtp) apunta a Mailpit.
# Para produccion con Brevo: MAIL_MAILER=brevo y credenciales SMTP de Brevo.
NOTIFICACIONES_MAILER=
# BREVO (SMTP) para produccion. Descomentar y cambiar MAIL_MAILER=brevo.
# BREVO_API_KEY=
# BREVO_SMTP_HOST=smtp-relay.brevo.com
# BREVO_SMTP_PORT=587
# BREVO_SMTP_USERNAME=
# BREVO_SMTP_PASSWORD=

# WhatsApp: microservicio Node (Baileys). URL interna en la red de Docker.
WHATSAPP_SERVICE_URL=http://whatsapp:3000
WHATSAPP_SERVICE_TOKEN=
WHATSAPP_SERVICE_TIMEOUT=5
WHATSAPP_MOCK=true

# --- Seguridad (paso 7) ---
# CORS: dominios de los DOS frontends, separados por coma. NUNCA '*'.
# En dev son los puertos de Vite; en prod, los dominios reales.
#   clinica-dental-portal  (staff)    -> primer origen
#   clinica-dental-paciente (publico) -> segundo origen
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Header con el slug de clinica para endpoints publicos (sin login).
TENANT_PUBLIC_HEADER=X-Clinica

# Rate limiting (peticiones por minuto). Ajustables sin tocar codigo.
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=10
RATE_LIMIT_AVAILABILITY=60
RATE_LIMIT_PUBLICO=30

VITE_APP_NAME="${APP_NAME}"
