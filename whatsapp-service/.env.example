# Puerto HTTP del microservicio.
PORT=3000

# Token Bearer compartido con Laravel (WHATSAPP_SERVICE_TOKEN en el .env de la API).
# Si se deja vacio, no se exige auth (solo aceptable en dev tras la red interna de Docker).
WHATSAPP_SERVICE_TOKEN=

# Modo mock: true = no abre sesion real, solo loguea los envios (por defecto en dev).
# Ponlo en false para vincular un numero real via QR.
WHATSAPP_MOCK=true

# Carpeta donde Baileys guarda las credenciales de la sesion (modo real).
WHATSAPP_AUTH_DIR=./auth

LOG_LEVEL=info
